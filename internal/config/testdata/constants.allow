# Package-level constants and variables that look like defaults, by their
# name, their type or their value, but belong in Go. TestNoDefaultsInGo
# fails on one this file doesn't list, and on a line that names none.
#
# One per line, as the path from the root of the module and the name:
#
#   path:Name  keep: why it is a true constant
#
# keep is for what the user has no reason to change: an API limit, a
# format version, a layout measure, a bound the validator enforces, or a
# safety mechanism. A default goes into default.yaml instead.

# The config package itself.
internal/config/defaults.go:defaultTree  keep: default.yaml parsed, what every default is read from
internal/config/defaults.go:defaultYAML  keep: default.yaml itself, embedded
internal/config/defaults.go:defaults  keep: default.yaml decoded, what Default copies
internal/config/prefetch.go:maxRest  keep: a bound Validate holds prefetch.*.rest to, not a default
internal/config/size.go:KiB  keep: a unit
internal/config/size.go:MiB  keep: a unit
internal/config/size.go:GiB  keep: a unit
internal/config/cache.go:minDiskSize  keep: a bound the validator enforces
internal/config/cache.go:minRevalidateInterval  keep: a bound the validator enforces
internal/config/config.go:minSyncInterval  keep: a bound the validator enforces
internal/config/github.go:maxPageSize  keep: a bound the validator enforces
internal/config/github.go:minPageSize  keep: a bound the validator enforces
internal/config/github.go:minTimeout  keep: a bound the validator enforces
internal/config/files.go:maxBlob  keep: an API limit, the largest file GitHub serves
internal/config/log.go:minLogSize  keep: a bound the validator enforces
internal/config/log.go:minLogSummary  keep: a bound the validator enforces
internal/config/ui.go:minToast  keep: a bound the validator enforces

# Polling.
internal/watch/options.go:DefaultMaxBackoff  keep: a safety mechanism, how far polls back off after errors
internal/watch/options.go:DefaultMinInterval  keep: a bound, the engine's own floor under sync.poll

# Caches.
internal/cache/disk/collect.go:tmpMaxAge  keep: a safety mechanism, when a temporary file counts as abandoned
internal/cache/disk/store.go:touchAfter  keep: a mechanism, how seldom a read marks an object used
internal/cache/disk/store.go:logEvery  keep: a log throttle, one record of a failure per kind and operation a while
internal/cache/shelf.go:shelfLogEvery  keep: a log throttle, one record of dropped entries per reason a while
internal/revalidate/options.go:DefaultConcurrency  keep: a safety mechanism, checks at once under the secondary limits
internal/revalidate/options.go:DefaultMaxBackoff  keep: a safety mechanism, how far passes back off after errors
internal/revalidate/options.go:DefaultStartDelay  keep: a mechanism, leaves a session's first reads to the views

# Services.
internal/service/actions/runs.go:workflowsPageSize  keep: an API limit, the largest page, so one page lists every workflow
internal/service/actions/jobs.go:DefaultJobPageSize  keep: an API limit, the largest page, so one page holds a run's jobs
internal/service/actions/checks.go:DefaultAnnotationPageSize  keep: annotations come a page at a time with the job; not a setting
internal/service/actions/partial.go:partialFresh  keep: a mechanism of live logs
internal/service/actions/partial.go:partialSlack  keep: a mechanism of live logs
internal/service/actions/service.go:maxPageSize  keep: an API limit
internal/service/actions/service.go:logLineSize  keep: a measure of the memory a log line takes
internal/service/files/service.go:treeEntrySize  keep: a measure of the memory an entry of a listing takes
internal/service/dashboard/work.go:maxPageSize  keep: an API limit
internal/service/dashboard/repos.go:DefaultReposSize  keep: an API limit, the largest page, so the pane lists them all
internal/service/owners/repos.go:maxPageSize  keep: an API limit
internal/service/owners/service.go:missingFor  keep: a mechanism, how long a login that no account has is remembered so a page read again at once asks no more
internal/service/history/branches.go:DefaultBranchPageSize  keep: an API limit, the largest page; branches are small
internal/service/history/service.go:maxPageSize  keep: an API limit
internal/service/issues/read.go:maxPageSize  keep: an API limit
internal/service/notifications/list.go:maxPageSize  keep: an API limit
internal/service/pulls/service.go:maxPageSize  keep: an API limit
internal/service/pulls/confirm.go:confirmFor  keep: a mechanism, how long a change waits for a full read to confirm it
internal/service/repos/repos.go:maxPageSize  keep: an API limit
internal/service/search/search.go:maxPageSize  keep: an API limit
internal/service/access/access.go:quiet  keep: a mechanism, how long startup waits for an answer before asking about the token

# The GitHub client.
internal/github/actions_logs.go:DefaultLogLimit  keep: a safety bound on how much of a job log is read
internal/github/actions_logs.go:logURLTTL  keep: an API limit, GitHub's log links expire after a minute
internal/github/budget.go:maxGuard  keep: a mechanism of the rate-limit budget
internal/github/budget.go:maxWindow  keep: an API limit, the longest rate-limit window
internal/github/budget.go:minGuard  keep: a mechanism of the rate-limit budget
internal/github/failing.go:failingAfter  keep: a mechanism of the status, how long server errors must last before the bar tells of them
internal/github/failing.go:failingClear  keep: a mechanism of the status, the hysteresis that keeps a resource failing now and then from flapping the bar and waking the polls
internal/github/failing.go:failingResume  keep: a mechanism of the status, how long a lapsed run of server errors keeps its start; above the longest poll backoff
internal/github/gate.go:deadlineMargin  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:foregroundWait  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:maxSecondaryBackoff  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:maxSecondaryWait  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:maxStagger  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:minStagger  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:probeTimeout  keep: a safety mechanism of the rate-limit gate
internal/github/gate.go:gateLogEvery  keep: a log throttle, one record of a held request per resource and reason a while
internal/github/ratelimit.go:secondaryBackoff  keep: GitHub's documented wait after a secondary limit that names none
internal/github/ratestatus.go:notifyEvery  keep: a mechanism, how often the status bar hears of the rate limit
internal/github/server.go:maxSkew  keep: a bound, how far GitHub's clock may drift before the log warns
internal/github/retry.go:retryTimeout  keep: the name of a reason to retry, not a duration
internal/github/retry.go:retryWithin  keep: a safety mechanism of retries
internal/github/retry.go:retryLogEvery  keep: a log throttle, one info record of a retry per reason a while
internal/core/target.go:DefaultHost  keep: gh's own default host, when gh names none
internal/core/target.go:defaultPorts  keep: the ports URLs of each scheme leave out

# Logging.
internal/logfile/logfile.go:followEvery  keep: a mechanism, how often a follower checks for rotation
internal/logfile/logfile.go:staleLock  keep: a safety mechanism, when a lock's holder counts as dead
cmd/gh-tui/login.go:refusedFor  keep: GitHub refuses such tokens every time; a day only spares a wasted request
cmd/gh-tui/login.go:unusedFor  keep: a cleanup of what rotated tokens leave behind; a token back after it is only asked about again
cmd/gh-tui/session.go:ghVersionTimeout  keep: a probe timeout, gh --version only prints
internal/obs/budget.go:fallbackPrefetchWindow  keep: used before GitHub reports a limit
internal/obs/stats.go:farReset  keep: a sanity bound on the reset GitHub reports

# Images.
internal/imgcaps/tmux.go:TmuxTimeout  keep: a safety mechanism, the most the startup check waits for tmux
internal/tui/files/preview.go:resizeRest  keep: a mechanism, how long a resize rests before markdown renders again
internal/tui/images.go:probeTimeout  keep: a safety mechanism, the most the startup check waits for the terminal
internal/tui/pictures.go:imagesWait  keep: a mechanism, how long images arriving together wait to be drawn together
internal/tui/pictures.go:quitFrame  keep: a mechanism, a frame for the deletes of the images to reach the terminal before quitting
internal/images/client.go:timeout  keep: a safety mechanism, the bound on one image's fetch
internal/images/decode.go:defaultCellHeight  keep: a layout measure, the cell size when the terminal doesn't say
internal/images/decode.go:defaultCellWidth  keep: a layout measure, the cell size when the terminal doesn't say
internal/images/gif.go:gifTick  keep: a unit of the GIF format, the hundredth of a second its delays count in
internal/images/gif.go:minGIFDelay  keep: compatibility, the shortest delay browsers play as given
internal/images/gif.go:slowGIFDelay  keep: compatibility, the delay browsers play a shorter one as
internal/images/fetch.go:failedFor  keep: a safety mechanism, how long a failed image isn't asked for again
internal/images/fetch.go:flightTimeout  keep: a safety mechanism, the bound on a shared fetch
internal/images/fetch.go:revalidateAfter  keep: how often an avatar may change, not a preference
internal/images/signed.go:expiryMargin  keep: a margin for clocks and transit on GitHub's signatures
internal/images/signed.go:unknownExpiry  keep: a safety mechanism, the life of a signature that can't be read
internal/images/signed.go:bodyFor  keep: under the life of GitHub's signed addresses, so they are read before they expire

# The tui.
internal/tui/search/section.go:DefaultDebounce  keep: the debounce of typing, a feel constant
internal/tui/ui/ahead.go:aheadFailedFor  keep: a safety mechanism, how long a row whose read ahead failed isn't read ahead again
internal/tui/cmdhistory.go:historyWait  keep: a mechanism, how long saving the command history waits for its lock
internal/tui/online.go:onlineGap  keep: a safety mechanism, how seldom a flapping connection wakes the failed panes
internal/tui/terminal.go:terminalWait  keep: a probe timeout, how long the terminal may take to say its version
internal/browser/browser.go:grace  keep: a mechanism, how long opening the browser listens for its opener to fail at once
internal/tui/ownerui/filter.go:DefaultSort  keep: what clear_filter puts back; set in the filter modal, not the config
internal/tui/issues/filter.go:defaultSort  keep: what clear_filter puts back; set in the filter modal, not the config
internal/tui/pulls/filter.go:defaultSort  keep: what clear_filter puts back; set in the filter modal, not the config
internal/tui/notifications/filter.go:defaultQuery  keep: what clear_filter puts back; set in the filter modal, not the config

# Bubbles and packages outside internal, which can't read the config: their
# defaults are those a bubble has on its own, and the tui passes a setting
# where there is one.
pkg/bubbles/toast/model.go:defaultMax  keep: a bubble's own default, a layout measure
pkg/bubbles/calendar/styles.go:DefaultGlyph  keep: a bubble's own default; the tui passes dashboard.calendar_glyph
pkg/bubbles/feed/options.go:DefaultMaxChunks  keep: a bubble's own default, a memory bound
pkg/bubbles/thread/options.go:DefaultMaxChunks  keep: a bubble's own default, a memory bound
pkg/bubbles/filterform/options.go:DefaultEditorHeight  keep: a bubble's own default, a layout measure
pkg/bubbles/finder/options.go:DefaultSyncLimit  keep: a bubble's own default, a bound on work in a frame
pkg/bubbles/graph/options.go:DefaultMaxLanes  keep: a bubble's own default, a layout measure
pkg/bubbles/logview/options.go:DefaultTabWidth  keep: a bubble's own default, as terminals set tabs
pkg/bubbles/pager/options.go:DefaultTabWidth  keep: a bubble's own default, a layout measure
pkg/bubbles/pager/options.go:DefaultHighlightLimit  keep: a bubble's own default, a bound on highlighting
pkg/bubbles/pager/highlight.go:lexLimit  keep: a bound on highlighting
pkg/bubbles/pager/editor.go:staleAfter  keep: a safety mechanism, when an editor's temporary file counts as abandoned
pkg/bubbles/picker/model.go:DefaultDebounce  keep: the debounce of typing, a feel constant
pkg/bubbles/tree/options.go:DefaultExpandAllDepth  keep: a bubble's own default, a safety bound on expand-all
pkg/bubbles/tree/options.go:DefaultExpandAllNodes  keep: a bubble's own default, a safety bound on expand-all
pkg/bubbles/tree/options.go:DefaultMaxLoads  keep: a bubble's own default, a bound on loads at once
pkg/bubbles/tree/options.go:DefaultScrollOff  keep: a bubble's own default, a layout measure
pkg/markdown/code.go:renderLexLimit  keep: a bound on highlighting
pkg/syntax/lex.go:Limit  keep: a bound on highlighting
pkg/syntax/lex.go:Wait  keep: a bound on highlighting
