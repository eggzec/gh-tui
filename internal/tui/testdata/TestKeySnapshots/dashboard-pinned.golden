# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | / | / | on
  find file | t ctrl+p | t | off
  zoom | z | z | on
  unzoom | esc | esc | off
  dismiss | ctrl+x | ctrl+x | off
  owner page | @ | @ | on
  notifications | n | n | on
  back | 0 | 0 | off
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 4 5 | 1-5 | on

Dashboard
  refresh | r | r | on
  this repo | . | . | on

Pinned
  left | left h | ←/h | on
  right | right l | →/l | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  open | enter | ↵ | on
  browser | o | o | on
