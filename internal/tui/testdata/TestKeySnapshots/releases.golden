# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  menu | menu x | menu/x | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | on
  zoom | z | z | on
  divider left | ctrl+left | ^left | on
  divider right | ctrl+right | ^right | on
  grow pane | ctrl+up | ^up | off
  shrink pane | ctrl+down | ^down | off
  reset dividers | = | = | off
  maximize | Z | Z | off
  dismiss | esc | esc | off
  back | backspace | backspace | off
  owner page | @ | @ | on
  this repo | . | . | off
  notifications | I | I | on
  dashboard | 0 | 0 | on
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 4 | 1-4 | on

Repository
  history | B | B | on
  actions | A | A | on
  star |  |  | off
  fork/parent | U | U | off

Releases
  open | enter | ↵ | on
  refresh | r | r | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g g home | gg/home | on
  last | G end | G/end | on
  retry | r | r | off
  search | / | / | on
  quick filter | & | & | on
  next match | n | n | off
  prev match | N | N | off
  expand | right l | →/l | off
  collapse | left h | ←/h | off
  all | * | * | off
