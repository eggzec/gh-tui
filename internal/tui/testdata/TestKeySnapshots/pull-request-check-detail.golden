# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  help | ? | ? | on

Checks
  checks | esc | esc | on
  rerun failed | R | R | off
  refresh | r | r | on
  browser | o | o | on

Detail
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b | on
  page down | space ctrl+f pgdown | space/^f | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | home g | g/home | on
  bottom | end G | G/end | on
  move left | left h | ←/h | on
  move right | right l | →/l | on
