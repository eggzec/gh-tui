# label | keys | help key | on or off

app
  quit | ctrl+c | ^c | on
  help | ? | ? | on

checks
  checks | esc | esc | on
  rerun failed | ctrl+r | ^r | off
  refresh | r | r | on
  browser | o | o | on
  open | enter | ↵ | off
  up | up k | ↑/k | off
  down | down j | ↓/j | off
  page up | ctrl+b pgup | ctrl+b/pgup | off
  page down | ctrl+f pgdown | ctrl+f/pgdn | off
  ½ page up | ctrl+u | ctrl+u | off
  ½ page down | ctrl+d | ctrl+d | off
  top | home g | g/home | on
  bottom | end G | G/end | on
  annotations | A | A | off

detail
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/ctrl+b/pgup | on
  page down | space ctrl+f pgdown | space/ctrl+f/pgdn | on
  ½ page up | ctrl+u | ctrl+u | on
  ½ page down | ctrl+d | ctrl+d | on
  move left | left h | ←/h | on
  move right | right l | →/l | on
