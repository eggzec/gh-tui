# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  maximize | Z | Z | on
  help | ? | ? | on

Pull request
  merge | M | M | on
  close | X | X | on
  reopen | O | O | off
  convert to draft | W | W | on
  checks | C | C | off

Detail
  checks | esc | esc | on
  refresh | r | r | on
  browser | o | o | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b/pgup | on
  page down | space ctrl+f pgdown | space/^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | g home | g/home | on
  bottom | G end | G/end | on
  move left | left h | ←/h | on
  move right | right l | →/l | on
