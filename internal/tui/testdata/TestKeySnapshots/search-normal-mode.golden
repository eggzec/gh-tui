global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | off
  zoom | z | z | off
  maximize | Z | Z | off
  dismiss | esc | esc | off
  back | backspace | backspace | on
  owner page | @ | @ | off
  this repo | . | . | off
  notifications | I | I | on
  dashboard | 0 | 0 | on
  next | tab | tab | on
  previous | shift+tab | shift+tab | on
  focus pane | 1 2 | 1/2 | on

Search
  type | i | i | on
