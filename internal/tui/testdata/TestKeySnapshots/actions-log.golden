# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  back | backspace | backspace | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Log
  annotations | A | A | on
  up | up k | ↑/k | off
  down | down j | ↓/j | off
  open file | enter | ↵ | off
  browser | o | o | off
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b/pgup | on
  page down | space ctrl+f pgdown | space/^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | g g home | gg/home | on
  bottom | G end | G/end | on
  fold | enter | ↵ | on
  all | * | * | on
  next error | e | e | off
  prev error | E | E | off
  next warning | w | w | off
  prev warning | W | W | off
  search | / | / | on
  search | enter | ↵ | off
  cancel | esc | esc | off
  next match | n | n | off
  prev match | N | N | off
  option: S N | - | - | on
  chop or wrap long lines | S | S | off
  line numbers | N | N | off
  cancel | esc | esc | off
  timestamps | x | x | on
  left | left h | ←/h | on
  right | right l | →/l | on
  follow | F | F | on
  close | q esc | q/esc | off
