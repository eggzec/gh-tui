# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  help | ? | ? | on

Filter
  previous field | k up | k | on
  next field | j down | j | on
  first field | g home | g | on
  query | G end | G | on
  previous | h left | h | on
  next | l right | l | on
  toggle | space | space | off
  insert | i | i | off
  append | a | a | off
  clear | delete backspace | delete | off
  apply | enter | ↵ | on
  close | esc | esc | on
  close | q | q | on
  retry | r | r | off
  next tab | ] | ] | on
  previous tab | [ | [ | on
  apply | enter | ↵ | off
  done | esc | esc | off
  up | up ctrl+p | ↑/ctrl+p | off
  down | down ctrl+n | ↓/ctrl+n | off
  page up | pgup | pgup | off
  page down | pgdown | pgdn | off
  open | enter | enter | off
  close | esc | esc | off
  scope | tab | tab | off
  previous scope | shift+tab | shift+tab | off
