# label | keys | help key | on or off

always
  quit | ctrl+c | ^c | on
  help | ? | ? | on

Order picker
  up | k up | k/↑ | on
  down | j down | j/↓ | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  half page up | ctrl+u | ^u | on
  half page down | ctrl+d | ^d | on
  top | g g home | gg/home | on
  bottom | G end | G/end | on
  search | / | / | on
  toggle | space | space | on
  apply | enter | ↵ | on
  close | esc | esc | on
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
