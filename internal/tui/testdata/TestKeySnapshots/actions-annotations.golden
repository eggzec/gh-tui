# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  back | backspace | backspace | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Log
  log | A | A | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  open file | enter | ↵ | on
  browser | o | o | off
  up | up k | ↑/k | off
  down | down j | ↓/j | off
  page up | b ctrl+b pgup | b/^b/pgup | off
  page down | space ctrl+f pgdown | space/^f/pgdn | off
  ½ page up | ctrl+u | ^u | off
  ½ page down | ctrl+d | ^d | off
  top | g g home | gg/home | off
  bottom | G end | G/end | off
  fold | enter | ↵ | off
  all | * | * | on
  next error | e | e | off
  prev error | E | E | off
  next warning | w | w | off
  prev warning | W | W | off
  search | / | / | off
  search | enter | ↵ | off
  cancel | esc | esc | off
  next match | n | n | off
  prev match | N | N | off
  option: S N | - | - | on
  chop or wrap long lines | S | S | off
  line numbers | N | N | off
  cancel | esc | esc | off
  timestamps | x | x | off
  left | left h | ←/h | off
  right | right l | →/l | off
  follow | F | F | on
  close | q esc | q/esc | off
