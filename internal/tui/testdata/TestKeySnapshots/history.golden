# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  search | S | S | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

History
  pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on
  browser | o | o | on
  back to head | H | H | off
  zoom | z | z | on
  close | esc | esc | on
  branches | backspace | backspace | on
  retry | r | r | off

Graph
  use as base | b | b | on
  open | enter | ↵ | off
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  newest | g home | g/home | on
  oldest loaded | G end | G/end | on
  diff | enter | ↵ | on
  retry | r | r | off
