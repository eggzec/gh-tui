# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | on
  zoom | z | z | on
  maximize | Z | Z | off
  unzoom | esc | esc | off
  back | backspace | backspace | off
  dismiss | ctrl+x | ^x | on
  owner page | @ | @ | on
  this repo | . | . | off
  notifications | I | I | on
  dashboard | 0 | 0 | on
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on

Repository
  history | B | B | on
  actions | A | A | on

Files
  refresh | r | r | on
  open | o | o | on
  back to head | H | H | off
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g home | g/home | on
  last | G end | G/end | on
  expand | right l | →/l | on
  collapse | left h | ←/h | on
  all | * | * | on
  preview | enter | ↵ | on
