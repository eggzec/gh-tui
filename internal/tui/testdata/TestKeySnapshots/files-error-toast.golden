# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | / | / | on
  find file | t ctrl+p | t | on
  zoom | z | z | on
  maximize | Z | Z | off
  unzoom | esc | esc | off
  dismiss | ctrl+x | ctrl+x | on
  owner page | @ | @ | on
  notifications | n | n | on
  dashboard | 0 | 0 | on
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on

Repository
  history | B | B | on
  actions | a | a | on

Files
  refresh | r | r | on
  open | o | o | on
  back to head | H | H | off
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | home g | g/home | on
  last | end G | G/end | on
  expand | + | + | on
  expand/enter | right l | →/l | on
  collapse | - left h | -/←/h | on
  expand all | * | * | on
  collapse all | = | = | on
  preview | enter | ↵ | on
