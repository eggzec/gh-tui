  open | enter | ↵ | off
  up | up k | ↑/k | off
  down | down j | ↓/j | off
  page up | pgup b | pgup/b | off
  page down | pgdown f | pgdn/f | off
  first | home g | g/home | off
  last | end G | G/end | off
  annotations | A | A | off

annotations
  annotations | A | A | off
  up | up k | ↑/k | off
  down | down j | ↓/j | off
  open file | enter | ↵ | off
  browser | o | o | off

log
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | pgup b | b/pgup | on
  page down | pgdown f | f/pgdn | on
  ½ page up | u ctrl+u | u | on
  ½ page down | d ctrl+d | d | on
  top | home g | g/home | on
  bottom | end G | G/end | on
  fold | space enter | space | on
  expand | + | + | on
  collapse | - | - | on
  fold all | * | * | on
