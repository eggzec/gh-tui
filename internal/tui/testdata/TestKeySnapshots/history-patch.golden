# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  maximize | Z | Z | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  search | S | S | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

History
  pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on
  browser | o | o | on
  back to head | H | H | off
  zoom | z | z | on
  back | esc | esc | off
  retry | r | r | off

Patch
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b/pgup | on
  page down | space ctrl+f pgdown | space/^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | g home | g/home | on
  bottom | G end | G/end | on
  left | left h | ←/h | on
  right | right l | →/l | on
  option: S N s i I | - | - | on
  chop or wrap long lines | S | S | off
  line numbers | N | N | off
  squeeze blank lines | s | s | off
  smart case | i | i | off
  ignore case | I | I | off
  cancel | esc | esc | off
  search | / | / | on
  filter | & | & | on
  search | enter | ↵ | off
  cancel | esc | esc | off
  cancel | backspace ctrl+h | backspace/^h | off
  next match | n | n | off
  prev match | N | N | off
  edit | v | v | on
  close | q esc | q/esc | on
