# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  back | backspace | backspace | off
  dashboard | 0 | 0 | off
  notifications | I | I | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Notifications
  open & read | enter | ↵ | on
  read | U | U | on
  done | D | D | on
  read all |  |  | off
  filter | f | f | on
  clear filters | F | F | off
  filter on/off | alt+f | alt+f | on
  group by | g | g | on
  group on/off | alt+g | alt+g | on
  sort | s | s | on
  sort on/off | alt+s | alt+s | on
  refresh | r | r | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g g home | gg/home | on
  last | G end | G/end | on
  retry | r | r | off
  search | / | / | on
  quick filter | & | & | on
  next match | n | n | off
  prev match | N | N | off
  expand | right l | →/l | off
  collapse | left h | ←/h | off
  all | * | * | off
  mark | space | space | on
