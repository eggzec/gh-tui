# label | keys | help key | on or off

app
  quit | ctrl+c | ^c | on
  help | ? | ? | on

history
  pane | tab ] | tab | on
  previous pane | shift+tab [ | shift+tab | on
  browser | o | o | on
  back to head | H | H | off
  zoom | z | z | on
  close | esc | esc | on
  use as base | space | space | on
  graph | enter | ↵ | on
  filter | / | / | on
  retry | r ctrl+r | r | off

branches
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ctrl+b/pgup | on
  page down | ctrl+f pgdown | ctrl+f/pgdn | on
  ½ page up | ctrl+u | ctrl+u | on
  ½ page down | ctrl+d | ctrl+d | on
  newest | home g | g/home | on
  oldest loaded | end G | G/end | on
  open | enter | enter | off
  retry | r | r | off
