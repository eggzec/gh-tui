# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

History
  pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on
  back to head | H | H | off
  zoom | z | z | on
  close | esc | esc | on
  back | backspace | backspace | off
  retry | r | r | off

Branches
  use as base | b | b | on
  graph | enter | ↵ | on
  filter | f | f | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g g home | gg/home | on
  last | G end | G/end | on
  retry | r | r | off
  search | / | / | on
  quick filter | & | & | on
  next match | n | n | off
  prev match | N | N | off
  expand | right l | →/l | off
  collapse | left h | ←/h | off
  all | * | * | off
