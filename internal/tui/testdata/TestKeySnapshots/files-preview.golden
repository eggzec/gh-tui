# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  help | ? | ? | on

File
  open | o | o | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b/pgup | on
  page down | space ctrl+f pgdown | space/^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | g home | g/home | on
  bottom | G end | G/end | on
  left | left h | ←/h | on
  right | right l | →/l | on
  option: S N s i I | - | - | on
  chop or wrap long lines | S | S | off
  line numbers | N | N | off
  squeeze blank lines | s | s | off
  smart case | i | i | off
  ignore case | I | I | off
  cancel | esc | esc | off
  search | / | / | on
  filter | & | & | on
  search | enter | ↵ | off
  cancel | esc | esc | off
  cancel | backspace ctrl+h | backspace/^h | off
  next match | n | n | off
  prev match | N | N | off
  edit | v | v | on
  close | q esc | q/esc | on
