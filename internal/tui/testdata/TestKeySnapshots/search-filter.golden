# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Filter
  previous field | k up | k/↑ | on
  next field | j down | j/↓ | on
  first field | g g home | gg/home | on
  last field | G end | G/end | on
  previous | h left | h/← | off
  next | l right | l/→ | off
  toggle | space | space | off
  insert | i | i | on
  append | a | a | on
  clear | delete | delete | on
  apply | enter | ↵ | on
  close | esc | esc | on
  close | q | q | on
  retry | r | r | off
  next tab | ] | ] | off
  previous tab | [ | [ | off
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  apply | enter | ↵ | off
  done | esc | esc | off
  up | up ctrl+p | ↑/^p | off
  down | down ctrl+n | ↓/^n | off
  clear | delete | delete | off
  choose | enter | ↵ | off
  close | esc | esc | off
  up | up ctrl+p | ↑/^p | off
  down | down ctrl+n | ↓/^n | off
  page up | pgup | pgup | off
  page down | pgdown | pgdn | off
  scope | tab | tab | off
  previous scope | shift+tab | shift+tab | off
  up | k up | k/↑ | off
  down | j down | j/↓ | off
  page up | ctrl+b pgup | ^b/pgup | off
  page down | ctrl+f pgdown | ^f/pgdn | off
