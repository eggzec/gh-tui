# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  maximize | Z | Z | on
  help | ? | ? | on

Checks
  detail | esc | esc | on
  rerun failed | R | R | on
  refresh | r | r | on
  browser | o | o | on

Checks
  log | enter | ↵ | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | home g | g/home | on
  last | end G | G/end | on
