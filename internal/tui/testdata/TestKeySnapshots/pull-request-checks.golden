# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  maximize | Z | Z | on
  dashboard | 0 | 0 | off
  notifications | I | I | off
  search | S | S | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Pull request
  merge | M | M | on
  close | X | X | on
  reopen | O | O | off
  convert to draft | W | W | on
  checks | C | C | off

Checks
  detail | esc | esc | on
  rerun failed | R | R | on
  refresh | r | r | on
  browser | o | o | on
  log | enter | ↵ | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g home | g/home | on
  last | G end | G/end | on
