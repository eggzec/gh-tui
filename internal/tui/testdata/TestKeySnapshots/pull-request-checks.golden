# label | keys | help key | on or off

app
  quit | ctrl+c | ^c | on
  help | ? | ? | on

checks
  detail | esc | esc | on
  rerun failed | ctrl+r | ^r | on
  refresh | r ctrl+r | r | on
  browser | o | o | on
  log | enter | ↵ | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ctrl+b/pgup | on
  page down | ctrl+f pgdown | ctrl+f/pgdn | on
  ½ page up | ctrl+u | ctrl+u | on
  ½ page down | ctrl+d | ctrl+d | on
  first | home g | g/home | on
  last | end G | G/end | on
  annotations | A | A | off
