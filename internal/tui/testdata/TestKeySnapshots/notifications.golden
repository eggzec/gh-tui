# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | off
  zoom | z | z | off
  maximize | Z | Z | off
  unzoom | esc | esc | off
  dismiss | ctrl+x | ^x | off
  owner page | @ | @ | on
  this repo | . | . | on
  back | I | I | on
  dashboard | 0 | 0 | on
  next pane | tab | tab | off
  previous pane | shift+tab | shift+tab | off
  focus pane | 1 2 3 | 1-3 | off

Notifications
  open & read | enter | ↵ | on
  open | o | o | on
  read | m | m | on
  done | d | d | on
  all read | M | M | on
  filter | f | f | on
  clear filters | F | F | off
  refresh | r | r | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g home | g/home | on
  last | G end | G/end | on
  retry | r | r | off
