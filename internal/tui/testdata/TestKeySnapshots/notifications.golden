# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | off
  zoom | z | z | off
  maximize | Z | Z | off
  dismiss | esc | esc | off
  back | backspace | backspace | on
  owner page | @ | @ | on
  this repo | . | . | on
  notifications | I | I | off
  dashboard | 0 | 0 | on
  next pane | tab | tab | off
  previous pane | shift+tab | shift+tab | off
  focus pane | 1 2 3 | 1-3 | off

Notifications
  open & read | enter | ↵ | on
  open | o | o | on
  read | U | U | on
  done | D | D | on
  read all |  |  | off
  filter | f | f | on
  clear filters | F | F | off
  filter on/off | alt+f | alt+f | on
  group by | g | g | on
  group on/off | alt+g | alt+g | on
  sort | s | s | on
  sort on/off | alt+s | alt+s | on
  refresh | r | r | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | g g home | gg/home | on
  last | G end | G/end | on
  retry | r | r | off
  search | / | / | on
  quick filter | & | & | on
  next match | n | n | off
  prev match | N | N | off
  expand | right l | →/l | off
  collapse | left h | ←/h | off
  all | * | * | off
  mark | space | space | on
