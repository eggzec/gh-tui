# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | S | S | on
  find file | ctrl+p | ^p | off
  zoom | z | z | on
  maximize | Z | Z | off
  unzoom | esc | esc | off
  back | backspace | backspace | off
  dismiss | ctrl+x | ^x | off
  owner page | @ | @ | off
  this repo | . | . | off
  notifications | I | I | on
  dashboard | 0 | 0 | off
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 4 5 | 1-5 | on

Dashboard
  refresh | r | r | on

Contributions
  week before | left h | ←/h | on
  week after | right l | →/l | on
  day before | up k | ↑/k | on
  day after | down j | ↓/j | on
  first day | g home | g/home | on
  last day | G end | G/end | on
