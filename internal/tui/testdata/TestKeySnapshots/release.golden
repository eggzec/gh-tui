# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  command | : | : | on
  maximize | Z | Z | on
  back | backspace | backspace | off
  dashboard | 0 | 0 | off
  notifications | I | I | off
  search | S | S | off
  this repo | . | . | off
  owner page | @ | @ | off
  help | ? | ? | on

Release
  close | esc | esc | on
  back | backspace | backspace | off
  open in browser | o | o | on
  retry | r | r | off
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | b ctrl+b pgup | b/^b/pgup | on
  page down | space ctrl+f pgdown | space/^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  top | g home | g/home | on
  bottom | G end | G/end | on
  diagram code | enter | ↵ | off
  retry |  |  | off
