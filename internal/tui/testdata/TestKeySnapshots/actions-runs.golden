# label | keys | help key | on or off

app
  quit | ctrl+c | ^c | on
  help | ? | ? | on

actions
  tab | ] | ] | on
  previous tab | [ | [ | on
  pane | tab ] | tab | on
  previous pane | shift+tab [ | shift+tab | on
  pane right | l | l | on
  pane left | h | h | on
  filter | f | f | on
  zoom | z | z | on
  browser | o | o | on
  rerun failed | ctrl+r | ^r | on
  rerun all | R | R | on
  rerun job | J | J | off
  cancel run | x | x | off
  refresh | r ctrl+r | r | on
  close | esc | esc | on
  jobs | enter | ↵ | on
  annotations | A | A | off

runs
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | pgup b | pgup/b | on
  page down | pgdown f | pgdn/f | on
  first | home g | g/home | on
  last | end G | G/end | on
  retry | r ctrl+r | r | off
