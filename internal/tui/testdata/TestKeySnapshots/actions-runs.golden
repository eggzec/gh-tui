# label | keys | help key | on or off

global
  quit | ctrl+c | ^c | on
  maximize | Z | Z | on
  help | ? | ? | on

Actions
  tab | ] | ] | on
  previous tab | [ | [ | on
  pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 | 1-3 | on
  filter | f | f | on
  zoom | z | z | on
  browser | o | o | on
  rerun failed | R | R | on
  rerun all |  |  | off
  cancel run | x | x | off
  refresh | r | r | on
  close | esc | esc | on

Runs
  jobs | enter | ↵ | on
  up | up k | ↑/k | on
  down | down j | ↓/j | on
  page up | ctrl+b pgup | ^b/pgup | on
  page down | ctrl+f pgdown | ^f/pgdn | on
  ½ page up | ctrl+u | ^u | on
  ½ page down | ctrl+d | ^d | on
  first | home g | g/home | on
  last | end G | G/end | on
  retry | r | r | off
