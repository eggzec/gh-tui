  search | / | / | on
  history | B | B | on
  actions | a | a | on
  find file | t ctrl+p | t | on
  filter | f | f | off
  sort | s | s | off
  zoom | z | z | on
  unzoom | esc | esc | on
  dismiss | ctrl+x | ctrl+x | off
  owner page | @ | @ | on
  notifications | n | n | on
