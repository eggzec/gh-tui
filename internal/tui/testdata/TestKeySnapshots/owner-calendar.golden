# label | keys | help key | on or off

global
  help | ? | ? | on
  command | : | : | on
  quit | q ctrl+c | q | on
  search | / | / | on
  find file | t ctrl+p | t | off
  zoom | z | z | on
  back | esc | esc | on
  dismiss | ctrl+x | ctrl+x | off
  owner page | @ | @ | off
  notifications | n | n | on
  dashboard | 0 | 0 | on
  next pane | tab | tab | on
  previous pane | shift+tab | shift+tab | on
  focus pane | 1 2 3 4 | 1-4 | on

Profile
  refresh | r | r | on

Contributions
  week before | left h | ←/h | on
  week after | right l | →/l | on
  day before | up k | ↑/k | on
  day after | down j | ↓/j | on
  first day | home g | g/home | on
  last day | end G | G/end | on
